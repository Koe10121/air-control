{
  "name": "air-control",
  "version": "0.1.0",
  "private": true,
  "description": "Control a website with your hands through the webcam. Runs 100% in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "fixtures:synthetic": "node scripts/make-synthetic-fixture.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.34"
  }
}
